---
import { MegaphoneSimpleIcon } from "@phosphor-icons/react/ssr";
import { DismissAnnouncement } from "@/components/layout/DismissAnnouncement";
import type { Update } from "@/lib/types";
import { href } from "@/lib/url";

interface Props {
  update: Update;
}

const { update } = Astro.props;
const label = update.kind === "build" ? "Nueva build" : "Novedad";
---

<div data-announcement class="bg-primary text-on-primary">
  <div class="mx-auto flex w-full max-w-6xl items-center gap-3 px-4 py-2 sm:px-6">
    <MegaphoneSimpleIcon size={20} aria-hidden className="hidden shrink-0 sm:block" />
    <p class="min-w-0 flex-1 text-[15px] leading-snug">
      <span class="font-bold">{label}:</span>{" "}
      <a
        href={href(`/novedades/${update.slug}`)}
        class="underline decoration-on-primary/40 underline-offset-4 hover:decoration-on-primary"
      >
        {update.title}. Léelo en español
      </a>
    </p>
    <DismissAnnouncement client:idle id={update.slug} />
  </div>
</div>

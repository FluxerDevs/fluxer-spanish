---
import { mainNav } from "@/data/site";
import { cx } from "@/lib/format";
import { href, stripBase } from "@/lib/url";

interface Props {
  class?: string;
}

const current = stripBase(Astro.url.pathname);
const isActive = (path: string) => current === path || current.startsWith(`${path}/`);
---

<nav aria-label="Principal" class={Astro.props.class}>
  <ul class="m-0 flex list-none items-center gap-1 p-0">
    {
      mainNav.map((item) => (
        <li class="m-0">
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={cx(
              "inline-flex min-h-11 items-center rounded-full px-4 font-semibold no-underline transition-colors duration-200",
              isActive(item.href)
                ? "bg-primary-soft text-on-primary-soft"
                : "text-fg-muted hover:bg-surface-muted hover:text-fg",
            )}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

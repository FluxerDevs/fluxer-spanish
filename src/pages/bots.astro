---
import { PlusIcon, RobotIcon } from "@phosphor-icons/react/ssr";
import { BotDirectory } from "@/components/bots/BotDirectory";
import { ButtonLink } from "@/components/ui/Button";
import Container from "@/components/ui/Container.astro";
import { PageHeader } from "@/components/ui/SectionHeader";
import { bots } from "@/data/bots";
import { site } from "@/data/site";
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout title="Directorio de bots" description="Bots para Fluxer con soporte en español, filtrados por categoría. También bots útiles en inglés, bien señalados.">
  <PageHeader
      icon={RobotIcon}
      title="Bots"
      description="Bots revisados por la comunidad. Cada uno indica si sus comandos están en español, en parte o solo en inglés."
    >
      <div class="mt-6">
        <ButtonLink href={site.socials.github} variant="secondary">
          <PlusIcon size={18} weight="bold" aria-hidden />
          Sugerir un bot
        </ButtonLink>
      </div>
      <p class="mt-4 text-sm text-fg-muted">Datos de ejemplo: el equipo aún está preparando el directorio.</p>
    </PageHeader>
    <section aria-label="Bots" class="py-12 sm:py-16">
      <Container>
        <BotDirectory client:load bots={bots} />
      </Container>
    </section>
</SiteLayout>

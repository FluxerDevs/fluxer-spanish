---
import { LayoutIcon, PlusIcon, UsersThreeIcon, VideoCameraIcon } from "@phosphor-icons/react/ssr";
import { CommunityDirectory } from "@/components/community/CommunityDirectory";
import { CreatorCard } from "@/components/community/CreatorCard";
import { TemplateCard } from "@/components/community/TemplateCard";
import { ButtonLink } from "@/components/ui/Button";
import Container from "@/components/ui/Container.astro";
import { PageHeader, SectionHeader } from "@/components/ui/SectionHeader";
import { creators, templates } from "@/data/community";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { listCommunities } from "@/lib/server/communities";

// Approved communities come from the database.
export const prerender = false;

const communities = await listCommunities();

const sections = [
  { id: "comunidades", label: "Comunidades" },
  { id: "plantillas", label: "Plantillas" },
  { id: "creadores", label: "Creadores" },
];
---

<SiteLayout title="Rincón de la comunidad" description="Comunidades en español para unirte, plantillas de servidor preconfiguradas y creadores hispanos en Fluxer.">
  <PageHeader
      icon={UsersThreeIcon}
      title="Comunidad"
      description="Servidores en español para unirte, plantillas para montar el tuyo y creadores hispanos que están en Fluxer."
    >
      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
        <ButtonLink href="/comunidad/enviar">
          <PlusIcon size={18} weight="bold" aria-hidden />
          Añadir mi servidor
        </ButtonLink>
        <nav aria-label="Secciones de la página" class="flex flex-wrap gap-2">
          {sections.map((section) => (
            <a
              href={`#${section.id}`}
              class="inline-flex min-h-10 items-center rounded-full border border-line bg-surface px-4 text-sm font-semibold hover:border-primary hover:text-primary"
            >
              {section.label}
            </a>
          ))}
        </nav>
      </div>
    </PageHeader>

    <section aria-labelledby="comunidades" class="scroll-mt-20 py-12 sm:py-16">
      <Container>
        <SectionHeader
          id="comunidades"
          icon={UsersThreeIcon}
          title="Comunidades en español"
          description="Servidores revisados por el equipo antes de aparecer aquí."
        />
        <p class="-mt-5 mb-6 text-sm text-fg-muted">Datos de ejemplo: el equipo aún está preparando el directorio.</p>
        <CommunityDirectory client:visible communities={communities} />
      </Container>
    </section>

    <section aria-labelledby="plantillas" class="scroll-mt-20 border-y border-line bg-surface-muted/60 py-12 sm:py-16">
      <Container>
        <SectionHeader
          id="plantillas"
          icon={LayoutIcon}
          title="Plantillas de servidor"
          description="Canales y roles ya organizados, con nombres en español. Úsalas tal cual o adáptalas."
        />
        <div class="grid gap-4 md:grid-cols-3">
          {templates.map((template) => (
            <TemplateCard template={template} />
          ))}
        </div>
      </Container>
    </section>

    <section aria-labelledby="creadores" class="scroll-mt-20 py-12 sm:py-16">
      <Container>
        <SectionHeader
          id="creadores"
          icon={VideoCameraIcon}
          title="Creadores hispanos"
          description="Streamers, artistas y divulgadores de la comunidad que están en Fluxer."
        />
        <p class="-mt-5 mb-6 text-sm text-fg-muted">Datos de ejemplo: el equipo aún está preparando la lista.</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {creators.map((creator) => (
            <CreatorCard creator={creator} />
          ))}
        </div>
      </Container>
    </section>
</SiteLayout>

---
import { ToolboxIcon } from "@phosphor-icons/react/ssr";
import { ToolCard } from "@/components/ecosystem/ToolCard";
import Container from "@/components/ui/Container.astro";
import { PageHeader } from "@/components/ui/SectionHeader";
import { toolGroupLabels, tools } from "@/data/tools";
import SiteLayout from "@/layouts/SiteLayout.astro";
import type { ToolGroup } from "@/lib/types";

const groups = Object.keys(toolGroupLabels) as ToolGroup[];
---

<SiteLayout title="Ecosistema y herramientas" description="Fluxer.host, Fluxername, feedback y más: enlaces útiles explicados en español.">
  <PageHeader
      icon={ToolboxIcon}
      title="Ecosistema"
      description="Webs, servicios y proyectos alrededor de Fluxer, con una explicación corta de para qué sirve cada uno."
    >
      <nav aria-label="Grupos" class="mt-6 flex flex-wrap gap-2">
        {groups.map((group) => (
          <a
            href={`#${group}`}
            class="inline-flex min-h-10 items-center rounded-full border border-line bg-surface px-4 text-sm font-semibold hover:border-primary hover:text-primary"
          >
            {toolGroupLabels[group].title}
          </a>
        ))}
      </nav>
    </PageHeader>

    <Container class="py-12 sm:py-16">
      <div class="space-y-14">
        {groups.map((group) => (
          <section aria-labelledby={group} class="scroll-mt-24">
            <h2 id={group} class="scroll-mt-24 text-2xl font-extrabold">
              {toolGroupLabels[group].title}
            </h2>
            <p class="mt-1 text-fg-muted">{toolGroupLabels[group].description}</p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {tools
                .filter((tool) => tool.group === group)
                .map((tool) => (
                  <ToolCard tool={tool} />
                ))}
            </div>
          </section>
        ))}
      </div>
    </Container>
</SiteLayout>

---
import { actions, isInputError } from "astro:actions";
import { CheckIcon, ClockCounterClockwiseIcon, ShieldCheckIcon, XIcon } from "@phosphor-icons/react/ssr";
import {
  formatSubmittedAt,
  SubmissionStatusBadge,
  submissionKindLabels,
} from "@/components/account/SubmissionStatus";
import { Badge } from "@/components/ui/Badge";
import { buttonClasses } from "@/components/ui/Button";
import Container from "@/components/ui/Container.astro";
import { EmptyState } from "@/components/ui/EmptyState";
import { PageHeader, SectionHeader } from "@/components/ui/SectionHeader";
import { botCategoryLabels, botLanguageLabels } from "@/data/bots";
import { communityTopicLabels } from "@/data/community";
import { toolGroupLabels } from "@/data/tools";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { formatNumber } from "@/lib/format";
import { getUser, isStaff } from "@/lib/server/auth";
import { listPending, listRecentDecisions } from "@/lib/server/moderation";
import type { SubmissionKind } from "@/lib/server/submissions";
import { href } from "@/lib/url";

export const prerender = false;

const user = await getUser(Astro);
if (!user) return Astro.redirect(`${href("/cuenta/entrar")}?volver=${encodeURIComponent(href("/moderacion"))}`);
// Don't reveal the page exists to anyone outside the team.
if (!isStaff(user.id)) return new Response(null, { status: 404 });

const kinds: SubmissionKind[] = ["community", "bot", "tool"];
const tabLabels: Record<SubmissionKind, string> = { community: "Comunidades", bot: "Bots", tool: "Herramientas" };
const requested = Astro.url.searchParams.get("tipo") as SubmissionKind | null;
const kind = requested && kinds.includes(requested) ? requested : "community";

// Form posts land here; after a decision, redirect so reloading doesn't post it again.
const result = Astro.getActionResult(actions.reviewSubmission);
if (result?.data) {
  return Astro.redirect(`${href("/moderacion")}?tipo=${result.data.kind}&hecho=${result.data.decision}`);
}
// Our own errors carry a Spanish message; input errors come from zod and don't.
const errorMessage =
  result?.error && (isInputError(result.error) ? "No se ha podido guardar la decisión." : result.error.message);
const done = Astro.url.searchParams.get("hecho");

const [pending, recent] = await Promise.all([listPending(), listRecentDecisions()]);
const items = pending[kind];

const submitterName = (submitter: { username: string; globalName: string | null }) =>
  submitter.globalName ? `${submitter.globalName} (@${submitter.username})` : `@${submitter.username}`;
---

<SiteLayout title="Moderación">
  <PageHeader
    icon={ShieldCheckIcon}
    title="Moderación"
    description="Envíos pendientes de revisión. Al aprobar uno aparece en la web al momento; al rechazarlo, quien lo envió ve el motivo en su cuenta."
  >
    <nav aria-label="Tipo de envío" class="mt-6 flex flex-wrap gap-2">
      {
        kinds.map((tab) => (
          <a
            href={`${href("/moderacion")}?tipo=${tab}`}
            aria-current={tab === kind ? "page" : undefined}
            class:list={[
              "inline-flex min-h-10 items-center gap-2 rounded-full border px-4 text-sm font-semibold",
              tab === kind
                ? "border-primary bg-primary-soft text-on-primary-soft"
                : "border-line bg-surface hover:border-primary hover:text-primary",
            ]}
          >
            {tabLabels[tab]}
            <span class="rounded-full bg-surface px-2 text-xs text-fg">{pending[tab].length}</span>
          </a>
        ))
      }
    </nav>
  </PageHeader>

  <Container class="py-12 sm:py-16">
    {
      errorMessage && (
        <p role="alert" class="mb-6 rounded-xl bg-danger-soft p-4 font-bold text-danger">
          {errorMessage}
        </p>
      )
    }
    {
      done && !errorMessage && (
        <p role="status" class="mb-6 rounded-xl bg-success-soft p-4 font-bold text-success">
          {done === "approve" ? "Aprobado: ya está publicado." : "Rechazado: quien lo envió verá el motivo."}
        </p>
      )
    }

    {
      items.length === 0 ? (
        <EmptyState title="No hay nada pendiente" description={`No quedan ${tabLabels[kind].toLowerCase()} por revisar.`} />
      ) : (
        <ul class="space-y-4">
          {items.map(({ row, submitter }) => (
            <li class="rounded-2xl border border-line bg-surface p-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h2 class="text-xl font-bold">{row.name}</h2>
                  <p class="mt-0.5 text-sm text-fg-muted">
                    Enviado por {submitterName(submitter)} el {formatSubmittedAt(row.createdAt)}
                  </p>
                </div>
                <SubmissionStatusBadge status={row.status} />
              </div>

              <dl class="mt-4 grid gap-x-6 gap-y-3 text-[15px] sm:grid-cols-[10rem_1fr]">
                {"guildId" in row && (
                  <>
                    <dt class="font-semibold">Descripción</dt>
                    <dd>{row.description}</dd>
                    <dt class="font-semibold">Invitación</dt>
                    <dd>
                      <a href={`https://fluxer.gg/${row.inviteCode}`} class="text-primary underline underline-offset-2" target="_blank" rel="noopener noreferrer">
                        fluxer.gg/{row.inviteCode}
                      </a>
                    </dd>
                    <dt class="font-semibold">Miembros</dt>
                    <dd>
                      {formatNumber(row.memberCount)}
                      {row.presenceCount !== null && ` (${formatNumber(row.presenceCount)} en línea)`}
                    </dd>
                    <dt class="font-semibold">Temas</dt>
                    <dd class="flex flex-wrap gap-1.5">
                      {row.topics.length > 0 ? row.topics.map((topic) => <Badge>{communityTopicLabels[topic]}</Badge>) : "Ninguno"}
                    </dd>
                    <dt class="font-semibold">ID del servidor</dt>
                    <dd class="font-mono text-sm">{row.guildId}</dd>
                  </>
                )}
                {"clientId" in row && (
                  <>
                    <dt class="font-semibold">Descripción</dt>
                    <dd>{row.description}</dd>
                    <dt class="font-semibold">Invitación</dt>
                    <dd class="break-all">
                      <a href={row.inviteUrl} class="text-primary underline underline-offset-2" target="_blank" rel="noopener noreferrer">
                        {row.inviteUrl}
                      </a>
                    </dd>
                    <dt class="font-semibold">Idioma</dt>
                    <dd>{botLanguageLabels[row.language]}</dd>
                    <dt class="font-semibold">Categorías</dt>
                    <dd class="flex flex-wrap gap-1.5">
                      {row.categories.map((category) => <Badge>{botCategoryLabels[category]}</Badge>)}
                    </dd>
                    {row.website && (
                      <>
                        <dt class="font-semibold">Web</dt>
                        <dd class="break-all">
                          <a href={row.website} class="text-primary underline underline-offset-2" target="_blank" rel="noopener noreferrer">
                            {row.website}
                          </a>
                        </dd>
                      </>
                    )}
                    <dt class="font-semibold">Client ID</dt>
                    <dd class="font-mono text-sm">{row.clientId}</dd>
                  </>
                )}
                {"tagline" in row && (
                  <>
                    <dt class="font-semibold">Enlace</dt>
                    <dd class="break-all">
                      <a href={row.url} class="text-primary underline underline-offset-2" target="_blank" rel="noopener noreferrer">
                        {row.url}
                      </a>
                    </dd>
                    <dt class="font-semibold">Sección</dt>
                    <dd>{toolGroupLabels[row.group].title}</dd>
                    <dt class="font-semibold">Resumen</dt>
                    <dd>{row.tagline}</dd>
                    <dt class="font-semibold">Para qué sirve</dt>
                    <dd>{row.purpose}</dd>
                  </>
                )}
              </dl>

              <div class="mt-6 grid gap-4 border-t border-line pt-5 md:grid-cols-[auto_1fr] md:items-end">
                <form method="POST" action={actions.reviewSubmission}>
                  <input type="hidden" name="kind" value={kind} />
                  <input type="hidden" name="id" value={row.id} />
                  <input type="hidden" name="decision" value="approve" />
                  <button type="submit" class={buttonClasses("primary")}>
                    <CheckIcon size={18} weight="bold" aria-hidden />
                    Aprobar
                  </button>
                </form>
                <form method="POST" action={actions.reviewSubmission} class="flex flex-col gap-2 sm:flex-row sm:items-end">
                  <input type="hidden" name="kind" value={kind} />
                  <input type="hidden" name="id" value={row.id} />
                  <input type="hidden" name="decision" value="reject" />
                  <label class="flex-1 text-sm font-semibold">
                    Motivo del rechazo
                    <input
                      type="text"
                      name="note"
                      required
                      maxlength="500"
                      placeholder="Por ejemplo: el servidor no está en español"
                      class="mt-1 block min-h-11 w-full rounded-xl border border-line-strong bg-surface px-3 text-base font-normal"
                    />
                  </label>
                  <button type="submit" class={buttonClasses("secondary")}>
                    <XIcon size={18} weight="bold" aria-hidden />
                    Rechazar
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <section aria-labelledby="recientes" class="mt-16">
      <SectionHeader id="recientes" icon={ClockCounterClockwiseIcon} title="Decisiones recientes" />
      {
        recent.length === 0 ? (
          <p class="text-fg-muted">Todavía no se ha revisado nada.</p>
        ) : (
          <ul class="divide-y divide-line rounded-2xl border border-line bg-surface">
            {recent.map((item) => (
              <li class="flex flex-col gap-2 p-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="font-bold">{item.name}</p>
                  <p class="text-sm text-fg-muted">
                    {submissionKindLabels[item.kind]} · por @{item.reviewer} el {formatSubmittedAt(item.reviewedAt)}
                  </p>
                  {item.reviewNote && <p class="mt-1 text-[15px]">{item.reviewNote}</p>}
                </div>
                <SubmissionStatusBadge status={item.status} />
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </Container>
</SiteLayout>

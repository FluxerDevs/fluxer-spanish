---
import {
  ArrowSquareOutIcon,
  BugBeetleIcon,
  PlusCircleIcon,
  TranslateIcon,
  TrendUpIcon,
} from "@phosphor-icons/react/ssr";
import { UpdateKindBadge } from "@/components/updates/UpdateCard";
import { ButtonLink } from "@/components/ui/Button";
import Container from "@/components/ui/Container.astro";
import { updates } from "@/data/updates";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { formatDate } from "@/lib/format";
import type { ChangelogSection, Update } from "@/lib/types";
import { href } from "@/lib/url";

export function getStaticPaths() {
  return updates.map((update) => ({ params: { slug: update.slug }, props: { update } }));
}

interface Props {
  update: Update;
}

const { update } = Astro.props;

const sectionIcons: Record<ChangelogSection["title"], typeof PlusCircleIcon> = {
  Nuevo: PlusCircleIcon,
  Mejoras: TrendUpIcon,
  Correcciones: BugBeetleIcon,
};
---

<SiteLayout title={update.title} description={update.summary}>
  <article class="py-10 sm:py-14">
    <Container class="max-w-3xl">
      <nav aria-label="Ruta de navegación" class="text-sm text-fg-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li>
            <a href={href("/novedades")} class="hover:text-primary">Novedades</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-fg">
            {update.version ? `Build ${update.version}` : update.title}
          </li>
        </ol>
      </nav>

      <header class="mt-6 border-b border-line pb-8">
        <div class="flex flex-wrap items-center gap-3 text-sm text-fg-muted">
          <UpdateKindBadge update={update} />
          <time datetime={update.date}>{formatDate(update.date)}</time>
          <span>· Anunciado por {update.author}</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">{update.title}</h1>
        <p class="mt-3 text-lg text-fg-muted">{update.summary}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <ButtonLink href={update.originalUrl} variant="secondary">
            <ArrowSquareOutIcon size={18} aria-hidden />
            Ver original (inglés)
          </ButtonLink>
        </div>
      </header>

      <div class="mt-8 space-y-10">
        {
          update.sections.map((section) => {
            const Icon = sectionIcons[section.title];
            return (
              <section aria-labelledby={`section-${section.title}`}>
                <h2 id={`section-${section.title}`} class="flex items-center gap-2 text-2xl font-extrabold">
                  <Icon size={24} aria-hidden className="text-primary" />
                  {section.title}
                </h2>
                <ul class="mt-4 space-y-3 text-[17px]">
                  {section.items.map((item) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-primary" />
                      {item}
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>

      <p class="mt-12 flex gap-2.5 rounded-2xl border border-line bg-surface p-5 text-[15px] text-fg-muted">
        <TranslateIcon size={20} aria-hidden className="mt-0.5 shrink-0 text-primary" />
        <span>
          Traducido por <strong class="text-fg">{update.translatedBy}</strong>. Es una traducción no oficial: si algo no
          cuadra, el texto original manda.
        </span>
      </p>
    </Container>
  </article>
</SiteLayout>

---
import { MegaphoneSimpleIcon, TranslateIcon } from "@phosphor-icons/react/ssr";
import { UpdateCard } from "@/components/updates/UpdateCard";
import Container from "@/components/ui/Container.astro";
import { PageHeader } from "@/components/ui/SectionHeader";
import { updates } from "@/data/updates";
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout title="Novedades" description="Las novedades y builds de Fluxer, traducidas al español por la comunidad.">
  <PageHeader
      icon={MegaphoneSimpleIcon}
      title="Novedades"
      description="Anuncios y builds de Fluxer traducidos por la comunidad, cada uno con enlace al texto original."
    >
      <p class="mt-5 inline-flex items-center gap-2 text-sm text-fg-muted">
        <TranslateIcon size={18} aria-hidden className="text-primary" />
        Traducción no oficial: si algo no cuadra, vale lo que dice el original.
      </p>
    </PageHeader>
    <section aria-label="Lista de novedades" class="py-12 sm:py-16">
      <Container>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {updates.map((update) => (
            <UpdateCard update={update} />
          ))}
        </div>
      </Container>
    </section>
</SiteLayout>

---
import { ArrowLeftIcon, CheckIcon } from "@phosphor-icons/react/ssr";
import { SuggestToolForm } from "@/components/ecosystem/SuggestToolForm";
import Container from "@/components/ui/Container.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { href } from "@/lib/url";

const checklist = [
  "Tiene que ver con Fluxer: para tu cuenta, tu servidor o tus bots.",
  "Funciona y se puede usar hoy.",
  "Si es de pago, que lo diga claramente en su web.",
];
---

<SiteLayout title="Sugerir una herramienta" description="Sugiere una web o un servicio para la página de ecosistema de Fluxer Español.">
  <Container class="py-10 sm:py-14">
    <a href={href("/ecosistema")} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-fg-muted hover:text-primary">
      <ArrowLeftIcon size={16} aria-hidden />
      Volver al ecosistema
    </a>

    <div class="mt-4 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <h1 class="text-3xl font-extrabold sm:text-4xl">Sugerir una herramienta</h1>
        <p class="mt-3 text-lg text-fg-muted">
          ¿Usas una web o un servicio para Fluxer que debería estar aquí? Mándanoslo con una línea
          sobre para qué sirve.
        </p>
        <div class="mt-8 rounded-2xl bg-surface-muted p-5">
          <h2 class="font-heading font-bold">Antes de enviarla, comprueba que:</h2>
          <ul class="mt-3 space-y-2 text-[15px]">
            {checklist.map((item) => (
              <li class="flex gap-2">
                <CheckIcon size={18} weight="bold" aria-hidden className="mt-0.5 shrink-0 text-success" />
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-fg-muted">Revisamos cada sugerencia a mano, normalmente en pocos días.</p>
        </div>
      </div>
      <SuggestToolForm client:load />
    </div>
  </Container>
</SiteLayout>

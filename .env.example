# Copy to .env for local development. In the cluster these come from a Secret.

# Public URL of the site. The OAuth redirect URI is SITE_URL + /cuenta/autorizado/.
SITE_URL=http://localhost:4321

# OAuth2 application from Fluxer (Settings > Applications).
FLUXER_CLIENT_ID=
FLUXER_CLIENT_SECRET=

# Comma-separated Fluxer user IDs that can open /moderacion.
STAFF_USER_IDS=

# Optional Fluxer webhook that gets a message for each new submission.
# STAFF_WEBHOOK_URL=

# Defaults, only change them if needed.
# FLUXER_API_URL=https://api.fluxer.app
# FLUXER_MEDIA_URL=https://fluxerusercontent.com
# DATABASE_PATH=.data/fluxer-es.db
